config COMP_MWW
	tristate "microWakeWord keyword-spotting component"
	depends on SOF_STAGING
	depends on CPP
	depends on STD_CPP17
	depends on IPC_MAJOR_4
	help
	  Select for microWakeWord component support. This module runs a
	  TensorFlow Lite Micro streaming keyword-spotting model (based on
	  OHF-Voice's micro-wake-word project) on MFCC features and wakes
	  the host via KPB/WoV when the wake word is detected.

if COMP_MWW

config COMP_MWW_DEBUG_TRACE
	bool "Verbose per-hop / per-inference debug traces"
	default n
	help
	  Enable mww per-hop and per-inference debug prints in the hot path.
	  Leave disabled for production and normal capture tuning.

config COMP_MWW_HIFI_NNLIB
	bool "Use HiFi4 nnlib optimized TFLM kernels"
	default y
	help
	  Build the CONV_2D, DEPTHWISE_CONV_2D, FULLY_CONNECTED, QUANTIZE,
	  DEQUANTIZE and other model operators from the TFLM Xtensa kernels
	  backed by the Cadence HiFi4 nnlib. Only effective when building
	  with the xt-clang toolchain; other toolchains use the portable
	  reference kernels.

config COMP_MWW_PROFILE
	bool "Per-operator inference cycle profiling"
	default n
	help
	  Measure CCOUNT cycles spent in each TFLM operator of the MWW
	  model and log the per-inference averages in the stream shutdown
	  summary. Only effective for the static (non-LLEXT) build.

config COMP_MWW_MODEL_FROM_CONTROL
	bool "Load MWW model from bytes control instead of built-in header"
	default n
	help
	  When enabled, the MWW wake-word model is loaded from a runtime
	  or topology configuration data blob via binary kcontrol (bytes control)
	  instead of using the static mww_model_data embedded in the firmware image.

choice COMP_MWW_MODEL
	prompt "microWakeWord built-in model"
	default COMP_MWW_MODEL_PIPELINE_ID
	help
	  Select which wake-word model to build into the firmware image.
	  By default, models are selected per pipeline ID at runtime, which
	  compiles all default models into the image. Alternatively, a single
	  built-in model can be selected at build time to save memory.

config COMP_MWW_MODEL_PIPELINE_ID
	bool "Select model via pipeline ID"
	help
	  Select model dynamically based on pipeline/slot ID (slot 0: strawberry,
	  slot 1: hi_intel, slot 2: orange). All default models from available
	  header files are built into the firmware image.

config COMP_MWW_MODEL_HI_INTEL
	bool "Hi Intel"
	help
	  Build only the "Hi Intel" keyword model (mww_model_data_hi_intel.h) into
	  the firmware image and use it as the built-in model.

config COMP_MWW_MODEL_HEY_JARVIS
	bool "Hey Jarvis"
	help
	  Build only the "Hey Jarvis" keyword model (mww_model_data_hey_jarvis.h) into
	  the firmware image and use it as the built-in model.

config COMP_MWW_MODEL_STRAWBERRY
	bool "Strawberry"
	help
	  Build only the "Strawberry" keyword model (mww_model_data_strawberry.h) into
	  the firmware image and use it as the built-in model.

config COMP_MWW_MODEL_ORANGE
	bool "Orange"
	help
	  Build only the "Orange" keyword model (mww_model_data_orange.h) into
	  the firmware image and use it as the built-in model.

config COMP_MWW_MODEL_BANANA
	bool "Banana"
	help
	  Build only the "Banana" keyword model (mww_model_data_banana.h) into
	  the firmware image and use it as the built-in model.

endchoice

config COMP_MWW_FAKE_WAKE_MS
	int "Fake wake timer delay in ms when wovdebug kcontrol is armed (0 = default 5000ms)"
	default 0
	help
	  Test aid for automated wake-on-voice testing. When the wovdebug volatile
	  switch kcontrol is set on a WOV slot, the firmware arms a timer with this
	  duration (or 5000ms if set to 0) after the pipeline is active/triggered.
	  Upon expiration, it fires a synthetic keyword detection to wake the host
	  and drain the KPB buffer, then auto-clears the wovdebug kcontrol back to 0.

config COMP_MWW_PCAN
	bool "Expect PCAN-normalized MFCC input"
	default y if COMP_MFCC_PCAN
	depends on COMP_MFCC_PCAN
	help
	  Select when the upstream MFCC component runs with PCAN
	  (Per-Channel AGC Normalization) enabled. In that mode the Mel
	  filterbank energies arriving at MWW are already normalized to the
	  int8 dynamic range, so the in-component peak-tracking AGC and the
	  Q9.23->Q1.7 requantization step are compiled out and each Mel value
	  is clamped and cast directly to int8. Leave disabled for the
	  classic non-PCAN MFCC pipeline that relies on MWW's built-in AGC.

endif # COMP_MWW
