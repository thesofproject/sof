# Probe configs

menu "Probe"

config PROBE
	tristate "Probes enabled"
	default m if LIBRARY_DEFAULT_MODULAR
	default y if CAVS
	help
	  Select for enabling debug probes to extract/inject buffers

if PROBE != n

config PROBE_POINTS_MAX
	int "Maximum probe points"
	depends on PROBE
	default 16
	help
	  Define maximum number of probes, extraction and injection combined.

config PROBE_DMA_MAX
	int "Maximum injection probe DMAs attached"
	depends on PROBE
	default 0
	help
	  Define maximum number of injection DMAs.

config PROBE_IMX_HOST_DMA
	bool "Extract probe data to a host ring through the i.MX host DMA"
	depends on PROBE && IMX && IPC_MAJOR_3 && ZEPHYR_NATIVE_DRIVERS
	help
	  On i.MX IPC3 platforms the host DMA is configured by the firmware,
	  so the kernel passes the host ring address in the PROBE_INIT
	  stream_tag and the DSP writes extraction data directly into it.
	  The firmware publishes a write counter in the ring header for the
	  kernel to poll, since the host DMA reports no position.

endif

endmenu
