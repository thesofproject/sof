/**
 * @file groups.dox
 * @brief Sound Open Firmware C API architecture group definitions.
 */

/**
 * @defgroup ipc4_api IPC4 Host-DSP Protocol
 * @brief Intel and AMD IPC4 protocol definitions, message structures, base firmware, gateways, and notifications.
 */

/**
 * @defgroup ipc4_envelope_api IPC4 Message Envelope & Dispatch
 * @ingroup ipc4_api
 * @brief 64-bit mailbox message envelope formats, primary/extension registers, command target routing, reply status, and compound message barriers.
 */

/**
 * @defgroup ipc4_base_fw_api IPC4 Base Firmware & Global Configuration
 * @ingroup ipc4_api
 * @brief Core 0 Base Firmware management, ADSP global properties, hardware capabilities, memory pools, power budget tables, and crash dump telemetry.
 */

/**
 * @defgroup ipc4_pipeline_api IPC4 Pipeline Lifecycle & State Machine
 * @ingroup ipc4_api
 * @brief Pipeline creation, priority assignments, state machine transitions (RESET, PAUSED, RUNNING, EOS), multi-pipeline synchronization, and save/restore.
 */

/**
 * @defgroup ipc4_module_api IPC4 Module Architecture & Dynamic Binding
 * @ingroup ipc4_api
 * @brief Module instantiation, dynamic queue/pin binding, small/large parameter configuration handshake, and module power transitions.
 */

/**
 * @defgroup ipc4_format_api IPC4 Audio Formats & Pin Contracts
 * @ingroup ipc4_api
 * @brief Audio format specification bitfields, sampling rates, bit depths, channel configurations, and pin format descriptors.
 */

/**
 * @defgroup ipc4_gateway_api IPC4 Hardware Audio Gateways
 * @ingroup ipc4_api
 * @brief Audio gateway addressing (HD-Audio host/link, SoundWire ALH aggregation, DMIC link, SSP/I2S), gateway attributes, and NHLT configuration blobs.
 */

/**
 * @defgroup ipc4_notification_api IPC4 Asynchronous Notifications & Telemetry Registers
 * @ingroup ipc4_api
 * @brief Unsolicited DSP-to-host notifications, resource event reports, keyword detection events, watchdog alerts, and Mailbox Window 0 status registers.
 */

/**
 * @defgroup ipc4_telemetry_probe_api IPC4 Telemetry, Logging & Audio Probes
 * @ingroup ipc4_api
 * @brief Host DMA trace logging control, audio probe injection and extraction data streams, and module-specific configuration payloads.
 */

/**
 * @defgroup ipc3_api IPC3 Host-DSP Protocol
 * @brief Legacy IPC3 protocol definitions, commands, and stream controls.
 */

/**
 * @defgroup module_api Audio Processing Components & Module Interface
 * @brief Unified interface contracts, lifecycle callbacks, and streaming endpoints for built-in audio components and dynamic LLEXT processing modules (Volume, Mixer, EQ, DRC, SRC, etc.).
 */

/**
 * @defgroup audio_pipeline_api Pipeline Graph & Lifecycle Infrastructure
 * @brief Directed Acyclic Graph (DAG) pipeline creation, scheduling binding, traversal, and lifecycle management.
 */

/**
 * @defgroup component_infra_api Audio Component Infrastructure & Driver Model
 * @brief Component driver interface, operations vtable, hardware abstraction, IPC binding, and state machines.
 */

/**
 * @defgroup audio_buffer_api Audio Buffer & Stream Infrastructure
 * @brief Interconnect buffers, circular stream buffers, abstract audio buffers, and lockless ring buffers.
 */

/**
 * @defgroup audio_format_api Audio Formats & Channel Routing
 * @brief Channel map parsing, stream conversion, and audio sample saturation routines.
 */

/**
 * @defgroup scheduling_api Scheduling Infrastructure
 * @brief Real-time task schedulers (Low-Latency Timer/DMA, Data Processing preemptible threads, Thread With Budget), scheduling domains, and task state machines.
 */

/**
 * @defgroup memory_api Memory Management Infrastructure
 * @brief System heaps, Virtual Memory Heap (VMH), virtual regions, cold DRAM staging, and audio buffer allocators.
 */

/**
 * @defgroup rtos_api RTOS Abstraction Layer
 * @brief RTOS primitives, synchronization (spinlocks, mutexes), task scheduling, clocks, timers, and cache management.
 */

/**
 * @defgroup dsp_math_api DSP Math & Filter Libraries
 * @brief Fixed-point, floating-point, FFT, FIR/IIR accelerators, and vector math routines.
 */

/**
 * @defgroup probe_api Telemetry, Logging & Probes
 * @brief Real-time DSP trace logging, probe extraction/injection buffers, DMA telemetry, and panic dumps.
 */

/**
 * @defgroup trace_logging_api Trace DMA & Dictionary Logging
 * @ingroup probe_api
 * @brief Circular host DMA trace buffers, dictionary-based logger (.ldc), runtime log level filtering, and panic crash dumps.
 */

/**
 * @defgroup audio_probe_api Audio Probes & Stream Tap Points
 * @ingroup probe_api
 * @brief Dynamic pipeline buffer extraction and injection probes, probe DMA frames, and synchronization sync words.
 */

/**
 * @defgroup telemetry_perf_api Hardware Telemetry & Performance Monitoring
 * @ingroup probe_api
 * @brief Core system ticks, CPU cycle utilization, component performance tracking, and SRAM Window 0/3 telemetry status registers.
 */

/**
 * @defgroup debug_stream_api Debug Streams & Low-Level Debugging
 * @ingroup probe_api
 * @brief Structured debug stream records, Memory Window 2 debug slots, mailbox debug dumps, and GDB target stub.
 */

/**
 * @defgroup platform_drivers_api Platform & Hardware Drivers
 * @brief Digital Audio Interfaces (DAI), Direct Memory Access (DMA), and Power Management (PM) runtime.
 */
