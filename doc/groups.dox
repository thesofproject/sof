/**
 * @file groups.dox
 * @brief Sound Open Firmware C API architecture group definitions.
 */

/**
 * @defgroup ipc4_api IPC4 Host-DSP Protocol
 * @brief Intel and AMD IPC4 protocol definitions, message structures, base firmware, gateways, and notifications.
 */

/**
 * @defgroup ipc3_api IPC3 Host-DSP Protocol
 * @brief Legacy IPC3 protocol definitions, commands, and stream controls.
 */

/**
 * @defgroup module_api Audio Processing Components & Module Interface
 * @brief Unified interface contracts, lifecycle callbacks, and streaming endpoints for built-in audio components and dynamic LLEXT processing modules (Volume, Mixer, EQ, DRC, SRC, etc.).
 */

/**
 * @defgroup audio_pipeline_api Pipeline Graph & Lifecycle Infrastructure
 * @brief Directed Acyclic Graph (DAG) pipeline creation, scheduling binding, traversal, and lifecycle management.
 */

/**
 * @defgroup component_infra_api Audio Component Infrastructure & Driver Model
 * @brief Component driver interface, operations vtable, hardware abstraction, IPC binding, and state machines.
 */

/**
 * @defgroup audio_buffer_api Audio Buffer & Stream Infrastructure
 * @brief Interconnect buffers, circular stream buffers, abstract audio buffers, and lockless ring buffers.
 */

/**
 * @defgroup audio_format_api Audio Formats & Channel Routing
 * @brief Channel map parsing, stream conversion, and audio sample saturation routines.
 */

/**
 * @defgroup scheduling_api Scheduling Infrastructure
 * @brief Real-time task schedulers (Low-Latency Timer/DMA, Data Processing preemptible threads, Thread With Budget), scheduling domains, and task state machines.
 */

/**
 * @defgroup memory_api Memory Management Infrastructure
 * @brief System heaps, Virtual Memory Heap (VMH), virtual regions, cold DRAM staging, and audio buffer allocators.
 */

/**
 * @defgroup rtos_api RTOS Abstraction Layer
 * @brief RTOS primitives, synchronization (spinlocks, mutexes), task scheduling, clocks, timers, and cache management.
 */

/**
 * @defgroup dsp_math_api DSP Math & Filter Libraries
 * @brief Fixed-point, floating-point, FFT, FIR/IIR accelerators, and vector math routines.
 */

/**
 * @defgroup probe_api Telemetry, Logging & Probes
 * @brief Real-time DSP trace logging, probe extraction/injection buffers, DMA telemetry, and panic dumps.
 */

/**
 * @defgroup platform_drivers_api Platform & Hardware Drivers
 * @brief Digital Audio Interfaces (DAI), Direct Memory Access (DMA), and Power Management (PM) runtime.
 */
