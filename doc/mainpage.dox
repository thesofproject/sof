/**
 * @mainpage Sound Open Firmware C API & Architecture Reference
 *
 * @section intro_sec Overview
 *
 * Sound Open Firmware (SOF) is an open-source, vendor-neutral audio Digital Signal
 * Processing (DSP) firmware infrastructure, SDK, and real-time execution environment
 * governed under the Linux Foundation.
 *
 * SOF provides transparent, deterministic, low-latency audio processing for modern computing
 * architectures ranging from client PCs and servers to embedded microcontrollers and IoT devices.
 * It supports diverse hardware platforms including Intel (CAVS, ACE 1.x, ACE 2.x, ACE 3.x),
 * AMD, NXP (i.MX8), MediaTek, Espressif (ESP32-P4), and PJRC (Teensy 4.1 / i.MX RT1062).
 *
 * The firmware runs atop real-time operating systems (primarily **Zephyr RTOS**, with XTOS support
 * on legacy platforms) and interfaces with host operating systems (Linux, ChromeOS, Android, Windows)
 * via high-throughput Mailbox IPC protocols (IPC4 and IPC3) and DMA streaming windows.
 *
 * ---
 *
 * @section subsystem_sec Subsystem Architecture & API Modules
 *
 * The firmware codebase is organized into modular functional subsystems. Each subsystem exposes
 * structured C APIs, data structures, and lifecycle interfaces:
 *
 * <table class="doxtable">
 * <tr>
 *   <th>Subsystem</th>
 *   <th>API Group</th>
 *   <th>Key Headers & Interfaces</th>
 *   <th>Description</th>
 * </tr>
 * <tr>
 *   <td><b>Host-DSP IPC4 Protocol</b></td>
 *   <td>
 *     @ref ipc4_api<br/>
 *     <small>(@ref ipc4_envelope_api, @ref ipc4_pipeline_api, @ref ipc4_module_api, @ref ipc4_format_api, @ref ipc4_gateway_api, @ref ipc4_base_fw_api, @ref ipc4_notification_api, @ref ipc4_telemetry_probe_api)</small>
 *   </td>
 *   <td>
 *     - @ref src/include/ipc4/header.h "ipc4/header.h"<br/>
 *     - @ref src/include/ipc4/pipeline.h "ipc4/pipeline.h"<br/>
 *     - @ref src/include/ipc4/module.h "ipc4/module.h"<br/>
 *     - @ref src/include/ipc4/gateway.h "ipc4/gateway.h"<br/>
 *     - @ref src/include/ipc4/base_fw.h "ipc4/base_fw.h"<br/>
 *     - @ref src/include/ipc4/notification.h "ipc4/notification.h"
 *   </td>
 *   <td>
 *     Modern Intel/AMD IPC4 messaging protocol: 64-bit mailbox envelope, base firmware configuration,
 *     dynamic module instantiation & binding, pipeline lifecycle state machines, hardware audio gateways,
 *     large parameter get/set fragmentation handshake, and asynchronous event notifications.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Host-DSP IPC3 Protocol</b></td>
 *   <td>@ref ipc3_api</td>
 *   <td>
 *     - @ref src/include/ipc/header.h "ipc/header.h"<br/>
 *     - @ref src/include/ipc/stream.h "ipc/stream.h"<br/>
 *     - @ref src/include/ipc/control.h "ipc/control.h"<br/>
 *     - @ref src/include/ipc/topology.h "ipc/topology.h"
 *   </td>
 *   <td>
 *     Legacy IPC3 protocol structures, stream control envelopes, DAI/buffer tokens, and mixer controls.
 *   </td>
 * </tr>

 * <tr>
 *   <td><b>Pipeline Graph & Lifecycle</b></td>
 *   <td>@ref audio_pipeline_api</td>
 *   <td>
 *     - @ref src/include/sof/audio/pipeline.h "sof/audio/pipeline.h"
 *   </td>
 *   <td>
 *     Audio pipeline Directed Acyclic Graph (DAG) construction, scheduling task binding (LL/DP),
 *     pipeline hierarchy traversal, and graph-wide state transitions.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Component Infrastructure</b></td>
 *   <td>@ref component_infra_api</td>
 *   <td>
 *     - @ref src/include/sof/audio/component.h "sof/audio/component.h"<br/>
 *     - @ref src/include/sof/audio/component_ext.h "sof/audio/component_ext.h"
 *   </td>
 *   <td>
 *     Unified audio component driver model (comp_ops), trigger state machines, IPC module bindings,
 *     copy limits, and remote multi-core IDC communication.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Audio Buffers & Streams</b></td>
 *   <td>@ref audio_buffer_api</td>
 *   <td>
 *     - @ref src/include/sof/audio/buffer.h "sof/audio/buffer.h"<br/>
 *     - @ref src/include/sof/audio/audio_buffer.h "sof/audio/audio_buffer.h"<br/>
 *     - @ref src/include/sof/audio/ring_buffer.h "sof/audio/ring_buffer.h"<br/>
 *     - @ref src/include/module/audio/audio_stream.h "module/audio/audio_stream.h"<br/>
 *     - @ref src/include/sof/audio/audio_stream.h "sof/audio/audio_stream.h"
 *   </td>
 *   <td>
 *     Interconnect buffers (comp_buffer), abstract audio buffers (sof_audio_buffer), circular
 *     stream endpoints, lockless ring buffers, and buffer transaction callbacks.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Audio Formats & Routing</b></td>
 *   <td>@ref audio_format_api</td>
 *   <td>
 *     - @ref src/include/sof/audio/channel_map.h "sof/audio/channel_map.h"<br/>
 *     - @ref src/include/sof/audio/format_generic.h "sof/audio/format_generic.h"
 *   </td>
 *   <td>
 *     Channel mapping extraction, multi-channel spatial routing, and sample format saturation arithmetic.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Scheduling Infrastructure</b></td>
 *   <td>@ref scheduling_api</td>
 *   <td>
 *     - @ref src/include/sof/schedule/schedule.h "sof/schedule/schedule.h"<br/>
 *     - @ref src/include/sof/schedule/ll_schedule.h "sof/schedule/ll_schedule.h"<br/>
 *     - @ref src/include/sof/schedule/ll_schedule_domain.h "sof/schedule/ll_schedule_domain.h"<br/>
 *     - @ref src/include/sof/schedule/dp_schedule.h "sof/schedule/dp_schedule.h"<br/>
 *     - @ref src/include/sof/schedule/twb_schedule.h "sof/schedule/twb_schedule.h"<br/>
 *     - @ref zephyr/include/rtos/task.h "rtos/task.h"
 *   </td>
 *   <td>
 *     Multi-tiered real-time scheduling infrastructure: Low-Latency (LL) timer and DMA domains,
 *     Data Processing (DP) preemptible worker threads with dynamic deadline evaluation,
 *     Thread With Budget (TWB) cycle accounting, and core task state machines.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Audio Processing Components & Modules</b></td>
 *   <td>@ref module_api</td>
 *   <td>
 *     - @ref src/include/module/module/interface.h "module/interface.h"<br/>
 *     - @ref src/include/module/module/api_ver.h "module/api_ver.h"<br/>
 *     - @ref src/include/module/module/base.h "module/base.h"<br/>
 *     - @ref src/include/module/audio/sink_api.h "module/audio/sink_api.h"<br/>
 *     - @ref src/include/module/audio/source_api.h "module/audio/source_api.h"<br/>
 *     - @ref src/include/module/audio/format.h "module/audio/format.h"<br/>
 *     - @ref src/include/module/module/system_service.h "module/system_service.h"<br/>
 *     - Built-in Modules: Volume, Mixer, EQ FIR/IIR, DRC, Multiband DRC, SRC, ASRC, Crossover, Smart Amp
 *   </td>
 *   <td>
 *     Standard and dynamic DSP audio processing modules and component contracts: lifecycle callbacks
 *     (init, prepare, process, config), source/sink streaming endpoints, LLEXT dynamic loading,
 *     and module adapter glue.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Memory Management Infrastructure</b></td>
 *   <td>@ref memory_api</td>
 *   <td>
 *     - @ref zephyr/include/rtos/alloc.h "rtos/alloc.h"<br/>
 *     - @ref src/include/sof/lib/vregion.h "sof/lib/vregion.h"<br/>
 *     - @ref zephyr/include/sof/lib/regions_mm.h "sof/lib/regions_mm.h"<br/>
 *     - @ref zephyr/include/sof/lib/vpage.h "sof/lib/vpage.h"<br/>
 *     - @ref src/include/sof/lib/fast-get.h "sof/lib/fast-get.h"<br/>
 *     - @ref zephyr/include/sof/lib/memory.h "sof/lib/memory.h"
 *   </td>
 *   <td>
 *     Multi-tier DSP memory subsystem: system heaps (sys_heap), Virtual Memory Heap (VMH),
 *     pre-allocated virtual regions (vregion lifetime vs interim), cold DRAM dynamic staging (fast_get),
 *     shared user/kernel buffers, and data cache coherency.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>RTOS Abstraction Layer (RAL)</b></td>
 *   <td>@ref rtos_api</td>
 *   <td>
 *     - @ref zephyr/include/rtos/spinlock.h "rtos/spinlock.h"<br/>
 *     - @ref zephyr/include/rtos/mutex.h "rtos/mutex.h"<br/>
 *     - @ref zephyr/include/rtos/wait.h "rtos/wait.h"<br/>
 *     - @ref zephyr/include/rtos/clk.h "rtos/clk.h"<br/>
 *     - @ref zephyr/include/rtos/cache.h "rtos/cache.h"<br/>
 *     - @ref zephyr/include/rtos/interrupt.h "rtos/interrupt.h"
 *   </td>
 *   <td>
 *     Operating system abstraction bridging Zephyr RTOS and hardware primitives:
 *     spinlocks, mutexes, condition variables, hardware timers, cache writeback/invalidation,
 *     and multi-core Inter-Domain Communication (IDC).
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>DSP Mathematics & Filters</b></td>
 *   <td>@ref dsp_math_api</td>
 *   <td>
 *     - @ref src/include/sof/math/trig.h "sof/math/trig.h"<br/>
 *     - @ref src/include/sof/math/fft.h "sof/math/fft.h"<br/>
 *     - @ref src/include/user/fir.h "user/fir.h"<br/>
 *     - @ref src/include/sof/math/iir_df1.h "sof/math/iir_df1.h"<br/>
 *     - @ref src/include/sof/math/numbers.h "sof/math/numbers.h"<br/>
 *     - @ref src/include/sof/math/matrix.h "sof/math/matrix.h"
 *   </td>
 *   <td>
 *     Optimized DSP mathematics routines: fixed-point arithmetic (Q1.15, Q1.31), vector operations,
 *     fast Fourier transforms (FFT), window functions, biquad filter solvers, and SIMD accelerators.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Telemetry, Logging & Probes</b></td>
 *   <td>@ref probe_api</td>
 *   <td>
 *     - @ref src/include/sof/probe/probe.h "sof/probe/probe.h"<br/>
 *     - @ref src/include/sof/trace/trace.h "sof/trace/trace.h"<br/>
 *     - @ref src/include/sof/debug/telemetry/telemetry.h "sof/debug/telemetry/telemetry.h"<br/>
 *     - @ref src/include/sof/debug/telemetry/performance_monitor.h "performance_monitor.h"
 *   </td>
 *   <td>
 *     Real-time DSP firmware telemetry: non-blocking trace DMA logging, probe injection and extraction
 *     tap buffers, CPU load monitoring, MIPS benchmarking, and post-mortem crash dump mailboxes.
 *   </td>
 * </tr>
 * <tr>
 *   <td><b>Platform & Hardware Drivers</b></td>
 *   <td>@ref platform_drivers_api</td>
 *   <td>
 *     - @ref zephyr/include/sof/lib/dai.h "sof/lib/dai.h"<br/>
 *     - @ref zephyr/include/sof/lib/dma.h "sof/lib/dma.h"<br/>
 *     - @ref zephyr/include/sof/lib/pm_runtime.h "pm_runtime.h"<br/>
 *     - @ref src/include/sof/platform.h "sof/platform.h"
 *   </td>
 *   <td>
 *     Low-level peripheral drivers: Digital Audio Interfaces (I2S/SSP, SoundWire, DMIC/PDM, HDA),
 *     Direct Memory Access (DMA) controllers, interrupt controllers, and Power Management (D0ix/D3) runtime.
 *   </td>
 * </tr>
 * </table>
 *
 * ---
 *
